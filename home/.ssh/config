# SSH client config. Ports the design from nixcfg's
# modules/home-manager/programs/cli/ssh.nix:
#
#   - Default identity (for unaliased hosts) = artifex key
#   - Two GitHub aliases that resolve to github.com but use different keys:
#       gh.anon → artifex key
#       gh.orig → Sam key
#   - One GitLab alias:
#       gl.orig → Sam key
#   - Alpine GitLab pinned to the artifex key
#
# GitKraken (libgit2/libssh2) reads ~/.ssh/known_hosts directly and ignores
# the HostKeyAlias from this file, so scripts/install/ssh.sh seeds those
# aliases as literal entries in known_hosts during install.

# --- alias hosts --------------------------------------------------------------

Host gh.anon
	HostName github.com
	IdentityFile ~/Vault/Keys/Artifex/ssh-private.key
	HostKeyAlias github.com

Host gh.orig
	HostName github.com
	IdentityFile ~/Vault/Keys/Sam/ssh-private.key
	HostKeyAlias github.com

Host gl.orig
	HostName gitlab.com
	IdentityFile ~/Vault/Keys/Sam/ssh-private.key
	HostKeyAlias gitlab.com

# --- pinned real hosts --------------------------------------------------------

Host gitlab.alpinelinux.org
	IdentityFile ~/Vault/Keys/Artifex/ssh-private.key

# --- default for everything else ---------------------------------------------

Host *
	IdentityFile ~/Vault/Keys/Artifex/ssh-private.key
